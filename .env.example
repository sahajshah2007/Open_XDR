# Copy this file to .env; preserve existing .env when upgrading.
DATABASE_URL=postgresql+psycopg2://openxdr:change_me@localhost:5432/openxdr
REDIS_URL=redis://localhost:6379/0
PROJECT_NAME="TwinTrace Lab"
API_V1_STR=/api/v1
DEBUG=false

# Generate secrets with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
JWT_SECRET=<GENERATE_A_RANDOM_SECRET>
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<CHOOSE_A_STRONG_PASSWORD>
INGEST_API_KEY=<GENERATE_A_RANDOM_API_KEY>
# Existing PostgreSQL volumes must retain their current password until rotated.
POSTGRES_PASSWORD=change_me

# Optional digital twin: set true and run docker compose --profile twin up --build -d
NEO4J_ENABLED=false
NEO4J_PASSWORD=<CHOOSE_A_NEO4J_PASSWORD>
# OTX can also be configured in the UI; no key is required for detection.
OTX_API_KEY=
